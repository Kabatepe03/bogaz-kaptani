; Engine configuration file.
config_version=5

[application]
config/name="Boğaz Kaptanı"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[autoload]
V12FerrySwap="*res://scripts/v12_ferry_swap.gd"
V20Wake="*res://scripts/v20_wake_ultra.gd"
V20WorldMaterials="*res://scripts/v20_world_materials.gd"
V20Landmarks="*res://scripts/v20_landmarks.gd"
V20EceabatFlag="*res://scripts/v20_eceabat_flag.gd"
V20RenderQuality="*res://scripts/v20_render_quality.gd"
V20CameraWarmup="*res://scripts/v20_camera_warmup.gd"
V20MarineTraffic="*res://scripts/v20_marine_traffic.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.gl_compatibility="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=8192
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1

[input]
throttle_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
throttle_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
steer_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
steer_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
camera_next={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67)]}
